<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 
      SMARTWATCH / WEAR OS HARDWARE CONFIGURATION:
      Declares watch hardware capability and standalone operation on Wear OS.
    -->
    <uses-feature android:name="android.hardware.type.watch" />
    <uses-feature android:name="android.hardware.sensor.heartrate" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />

    <!-- 
      ZERO-CLOUD PRIVACY ENFORCEMENT:
      No android.permission.INTERNET declared!
      The app runs 100% locally from bundled assets with offline on-device storage.
    -->

    <application
        android:allowBackup="false"
        android:label="InstaHealth"
        android:supportsRtl="true"
        android:theme="@style/Theme.InstaHealth">
        
        <!-- Crucial for Wear OS: tells watch OS this is a standalone app without a companion phone needed -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
